# Synology user/group that owns config and output directories
PUID=1026
PGID=100
# Numeric group owner of /dev/dri/renderD128 (`ls -ln /dev/dri`)
VIDEO_GID=937
TZ=Europe/Amsterdam
SLIDESHOW_PORT=8080
RENDER_WORKERS=1
LOG_LEVEL=INFO

# Use absolute Synology paths when deploying in Container Manager
CONFIG_PATH=/volume1/docker/slideshow/config
PHOTOS_PATH=/volume1/photo
VIDEOS_PATH=/volume1/video
MUSIC_PATH=/volume1/music
OUTPUT_PATH=/volume1/video/slideshows
