# Synology user/group that owns config and output directories
PUID=1026
PGID=100
# Numeric group owner of /dev/dri/renderD128 (`ls -ln /dev/dri`)
VIDEO_GID=937
TZ=Europe/Amsterdam
SLIDESHOW_PORT=8080
RENDER_WORKERS=1
LOG_LEVEL=INFO

# Media validation against slow NAS volumes / network mounts. 0-byte files
# (e.g. cloud-synced placeholders that hydrate on access) are re-checked
# several times before a render fails, and ffprobe gets a generous timeout
# with one automatic retry.
# FFPROBE_TIMEOUT=30
# MEDIA_PROBE_RETRIES=2
# MEDIA_PROBE_RETRY_DELAY=0.75

# Use absolute Synology paths when deploying in Container Manager
CONFIG_PATH=/volume1/docker/slideshow/config
PHOTOS_PATH=/volume1/photo
VIDEOS_PATH=/volume1/video
MUSIC_PATH=/volume1/music
OUTPUT_PATH=/volume1/video/slideshows
# Where files uploaded from the GUI device ("Upload from this device") are
# stored. Use an absolute Synology path in Container Manager.
# Must exist and be owned by PUID:PGID (chown -R PUID:PGID <path>), otherwise
# "Upload from this device" is refused with a "not writable" reason.
UPLOADS_PATH=/volume1/docker/slideshow/uploads
# Hard cap per uploaded file in MB (default 4096).
# UPLOAD_MAX_MB=4096
